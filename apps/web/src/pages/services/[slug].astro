---
import PublicLayout from '../../layouts/PublicLayout.astro'
import { createClient as createStaticClient } from '../../lib/supabase'

const supabase = createStaticClient()
const { slug } = Astro.params

const [{ data: service }, { data: others }] = await Promise.all([
  supabase.from('services').select('*').eq('slug', slug).eq('published', true).single(),
  supabase.from('services').select('id, title, slug').neq('slug', slug).limit(4),
])

// Return proper 404 instead of redirect
if (!service) {
  Astro.response.status = 404
  Astro.response.statusText = 'Not Found'
}

import { getSettings } from '../../lib/settings'
const settings = await getSettings()
const PHONE = settings.phone
const WHATSAPP = settings.whatsapp.replace(/\D/g, '')
const SITE_URL = (import.meta.env.NEXT_PUBLIC_SITE_URL || 'https://example.com').replace(/\/$/, '')
const waLink = service
  ? `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(`مرحباً، أريد الاستفسار عن خدمة: ${service.title}`)}`
  : `https://wa.me/${WHATSAPP}`
const canonicalUrl = `${SITE_URL}/services/${slug}`

const icons: Record<string, string> = {
  'kashf-tasaroubat-almaya': '🔍', 'azl-alsotouh-waljedran': '🏗️',
  'azl-alkhazanat-walmasabeh': '🏊', 'kashf-tasaroubat-algaz': '⚠️',
  'moualajat-alrotuba-wa-izalat-alaofoun': '💧', 'syanat-wa-islah-tasaroubat-alsibaka': '🔧',
}

// ── FAQ data per service (these appear as rich results in Google) ──
const faqsBySlug: Record<string, { q: string; a: string }[]> = {
  'kashf-tasaroubat-almaya': [
    { q: 'كيف أعرف أن هناك تسرب مياه في منزلي؟', a: 'من أبرز العلامات: ارتفاع غير مبرر في فاتورة المياه، ظهور بقع رطبة أو تغير لون الجدران والأرضيات، سماع صوت مياه جارية عند إغلاق جميع الحنفيات، وظهور روائح كريهة من العفن والرطوبة.' },
    { q: 'هل كشف التسربات يحتاج تكسير؟', a: 'لا، نستخدم أجهزة إلكترونية حديثة للكشف عن التسربات بدون أي تكسير. تشمل أجهزة الضغط، الكاميرات الحرارية، وأجهزة الموجات الصوتية التي تحدد مكان التسرب بدقة عالية.' },
    { q: 'كم تستغرق عملية كشف التسربات؟', a: 'عادةً ما تستغرق عملية الفحص والكشف من ساعة إلى 3 ساعات حسب حجم المبنى وعدد نقاط الفحص المطلوبة. نقدم تقريراً مفصلاً بعد الانتهاء.' },
    { q: 'ما هي تكلفة كشف التسربات؟', a: 'تختلف التكلفة حسب حجم المبنى ونوع الفحص المطلوب. نقدم فحصاً مبدئياً مجانياً وعرض سعر واضح قبل بدء العمل. تواصل معنا للحصول على عرض سعر فوري.' },
  ],
  'azl-alsotouh-waljedran': [
    { q: 'ما أفضل أنواع العزل للأسطح في السعودية؟', a: 'نستخدم عدة أنواع تناسب المناخ السعودي: العزل المائي بالبيتومين والأغشية، العزل الحراري بالفوم (البولي يوريثان)، والعزل العاكس للحرارة. يتم اختيار النوع الأنسب بناءً على طبيعة السطح والميزانية.' },
    { q: 'كم سنة يستمر العزل؟', a: 'العزل الجيد يستمر من 10 إلى 25 سنة حسب نوع المواد المستخدمة وجودة التنفيذ. نقدم ضمانات تتراوح بين 5 إلى 15 سنة على جميع أعمالنا.' },
    { q: 'هل يمكن عزل السطح بدون إزالة العزل القديم؟', a: 'في كثير من الحالات نعم، يمكن تطبيق طبقة عزل جديدة فوق القديمة بعد التأكد من سلامة السطح الأساسي. فريقنا يقوم بفحص شامل لتحديد الطريقة الأنسب.' },
  ],
  'azl-alkhazanat-walmasabeh': [
    { q: 'لماذا يجب عزل خزانات المياه؟', a: 'عزل الخزانات يمنع تسرب المياه ونمو البكتيريا والطحالب، ويحافظ على جودة المياه ونظافتها. كما يحمي الخزان من التشققات والتآكل ويطيل عمره الافتراضي.' },
    { q: 'ما المواد المستخدمة في عزل الخزانات؟', a: 'نستخدم مواد آمنة وصحية معتمدة مثل الإيبوكسي الغذائي والبولي يوريثان المائي. جميع المواد مصرح بها وآمنة للاستخدام مع مياه الشرب.' },
    { q: 'كم مرة يجب تجديد عزل الخزان؟', a: 'يُنصح بفحص العزل كل 3-5 سنوات وتجديده عند الحاجة. مع مواد العزل الحديثة، يمكن أن يستمر العزل حتى 10 سنوات.' },
  ],
  'kashf-tasaroubat-algaz': [
    { q: 'ما هي علامات تسرب الغاز في المنزل؟', a: 'أهم العلامات: رائحة غاز غير طبيعية (تشبه رائحة البيض الفاسد)، صوت هسهسة قرب أنابيب الغاز، ارتفاع غير مبرر في فاتورة الغاز، أو ذبول النباتات القريبة من خطوط الغاز.' },
    { q: 'هل كشف تسربات الغاز خطير؟', a: 'تسربات الغاز خطيرة جداً وقد تؤدي لحرائق أو انفجارات. لذلك يجب الاتصال بمتخصصين فوراً عند الشك بوجود تسرب. فريقنا مدرب ومجهز بأحدث أجهزة الكشف الآمنة.' },
    { q: 'كم تكلفة فحص تسرب الغاز؟', a: 'نقدم خدمة فحص مبدئي مجاني في معظم الحالات. تكلفة الإصلاح تعتمد على موقع ونوع التسرب. تواصل معنا للحصول على تقييم فوري.' },
  ],
}

const faqs = service ? (faqsBySlug[service.slug] ?? []) : []

// ── JSON-LD: BreadcrumbList ──
const breadcrumbJsonLd = service ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'خدماتنا', item: `${SITE_URL}/services` },
    { '@type': 'ListItem', position: 3, name: service.title, item: canonicalUrl },
  ],
} : null

// ── JSON-LD: Service schema ──
const serviceJsonLd = service ? {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.description,
  url: canonicalUrl,
  provider: {
    '@type': 'LocalBusiness',
    name: settings.site_title,
    url: SITE_URL,
    telephone: PHONE,
  },
  areaServed: { '@type': 'Country', name: 'SA' },
  ...(service.image_url ? { image: service.image_url } : {}),
} : null

// ── JSON-LD: FAQ schema (triggers FAQ rich results in Google!) ──
const faqJsonLd = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null
---

<PublicLayout
  title={service ? service.title : 'الخدمة غير موجودة'}
  description={service ? service.description.slice(0, 160) : undefined}
  image={service?.image_url || undefined}
  canonical={canonicalUrl}
>
  {serviceJsonLd && <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceJsonLd)} />}
  {breadcrumbJsonLd && <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbJsonLd)} />}
  {faqJsonLd && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqJsonLd)} />}

  <div id="main-content">
    {!service ? (
      <!-- 404 Page -->
      <div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4 py-20">
        <span class="text-8xl mb-6" aria-hidden="true">🔧</span>
        <h1 class="text-3xl font-extrabold text-gray-900 mb-3">الخدمة غير موجودة</h1>
        <p class="text-gray-500 mb-8 max-w-md">عذراً، لم نتمكن من العثور على الخدمة المطلوبة. ربما تم حذفها أو تغيير رابطها.</p>
        <a href="/services" class="btn-primary">تصفح جميع الخدمات</a>
      </div>
    ) : (
      <>
        <!-- Hero -->
        <div class="bg-gradient-hero py-14 relative overflow-hidden">
          <div class="absolute bottom-0 left-0 right-0" aria-hidden="true">
            <svg viewBox="0 0 1440 40" fill="none" role="presentation"><path d="M0 40L1440 40L1440 20C1200 0 960 0 720 10C480 20 240 30 0 20V40Z" fill="white"/></svg>
          </div>
          <div class="relative max-w-5xl mx-auto px-4 text-center">
            <a href="/services" class="inline-flex items-center gap-2 text-blue-200 hover:text-white mb-6 text-sm transition-colors">← جميع الخدمات</a>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-white mb-4">{service.title}</h1>
          </div>
        </div>

        <!-- Content -->
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
          <div class="grid lg:grid-cols-3 gap-10">
            <div class="lg:col-span-2">
              <!-- Service image -->
              <div class="w-full h-72 rounded-2xl overflow-hidden mb-8 shadow-lg bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center">
                {service.image_url ? (
                  <img
                    src={service.image_url}
                    alt={service.title}
                    width="800"
                    height="450"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <span class="text-9xl" aria-hidden="true">{icons[service.slug] || '🔧'}</span>
                )}
              </div>

              <!-- Description -->
              <div class="bg-white rounded-2xl border border-gray-100 p-8 shadow-sm mb-8">
                <h2 class="text-2xl font-bold text-blue-900 mb-6 border-b border-blue-50 pb-4">نبذة عن الخدمة</h2>
                <p class="text-gray-700 leading-loose text-lg">{service.description}</p>
              </div>

              <!-- FAQ Section — triggers FAQ rich results in Google -->
              {faqs.length > 0 && (
                <div class="bg-white rounded-2xl border border-gray-100 p-8 shadow-sm">
                  <h2 class="text-2xl font-bold text-blue-900 mb-6 border-b border-blue-50 pb-4">❓ الأسئلة الشائعة</h2>
                  <div class="space-y-4">
                    {faqs.map((faq, i) => (
                      <details class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden" id={`faq-${i + 1}`}>
                        <summary class="flex items-center justify-between px-5 py-4 cursor-pointer text-gray-900 font-bold text-sm hover:bg-blue-50 transition-colors list-none">
                          <span>{faq.q}</span>
                          <span class="text-blue-500 group-open:rotate-180 transition-transform duration-200 flex-shrink-0 mr-3" aria-hidden="true">▼</span>
                        </summary>
                        <div class="px-5 pb-4 text-gray-600 text-sm leading-relaxed border-t border-gray-100 pt-3">
                          {faq.a}
                        </div>
                      </details>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <!-- Sidebar -->
            <aside class="space-y-5">
              <div class="bg-gradient-to-br from-blue-600 to-blue-900 rounded-2xl p-6 text-white text-center sticky top-24">
                <div class="text-5xl mb-4" aria-hidden="true">📞</div>
                <h3 class="font-extrabold text-xl mb-2">احصل على عرض السعر</h3>
                <p class="text-blue-100 text-sm mb-6">فحص مجاني وعرض سعر فوري</p>
                <a href={`tel:${PHONE}`} id="service-detail-call-btn" class="btn-primary w-full justify-center mb-3 !rounded-xl block text-center">اتصل الآن</a>
                <a href={waLink} id="service-detail-wa-btn" target="_blank" rel="noopener noreferrer" class="btn-whatsapp w-full justify-center !rounded-xl block text-center">واتساب</a>
              </div>

              {others && others.length > 0 && (
                <nav aria-label="خدمات أخرى" class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm">
                  <h3 class="font-bold text-gray-900 mb-4">خدمات أخرى</h3>
                  <ul class="space-y-2">
                    {others.map(s => (
                      <li>
                        <a href={`/services/${s.slug}`} class="flex items-center gap-2 text-blue-600 hover:text-blue-800 text-sm font-medium transition-colors py-1">
                          <span class="w-1.5 h-1.5 rounded-full bg-blue-300 flex-shrink-0" aria-hidden="true"></span>{s.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              )}
            </aside>
          </div>
        </div>
      </>
    )}
  </div>
</PublicLayout>
