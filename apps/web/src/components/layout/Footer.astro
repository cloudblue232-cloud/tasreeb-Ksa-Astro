---
import { getSettings } from '../../lib/settings'
const settings = await getSettings()
const PHONE = settings.phone
---

<footer class="bg-blue-950 text-white pt-14 pb-6 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-10">

      <!-- Brand -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-3xl" aria-hidden="true">🔍</span>
          <span class="font-extrabold text-xl">{settings.site_title}</span>
        </div>
        <p class="text-blue-200 text-sm leading-relaxed max-w-xs">
          {settings.site_description}
        </p>
        <div class="flex items-center gap-3 mt-5">
          <a href={`tel:${PHONE}`} class="text-blue-200 hover:text-white text-sm transition-colors">
            <span aria-hidden="true">📞</span> {PHONE}
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <nav aria-label="روابط سريعة">
        <h3 class="font-bold text-white mb-4">روابط سريعة</h3>
        <ul class="space-y-2">
          {[['/', 'الرئيسية'], ['/services', 'خدماتنا'], ['/articles', 'المقالات']].map(([href, label]) => (
            <li><a href={href} class="text-blue-200 hover:text-white text-sm transition-colors">{label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Services — now actual links for SEO internal linking -->
      <nav aria-label="خدماتنا">
        <h3 class="font-bold text-white mb-4">خدماتنا</h3>
        <ul class="space-y-2">
          <li><a href="/services/kashf-tasaroubat-almaya" class="text-blue-200 hover:text-white text-sm transition-colors">كشف تسربات المياه</a></li>
          <li><a href="/services/azl-alsotouh-waljedran" class="text-blue-200 hover:text-white text-sm transition-colors">عزل الأسطح والجدران</a></li>
          <li><a href="/services/azl-alkhazanat-walmasabeh" class="text-blue-200 hover:text-white text-sm transition-colors">عزل الخزانات والمسابح</a></li>
          <li><a href="/services/kashf-tasaroubat-algaz" class="text-blue-200 hover:text-white text-sm transition-colors">كشف تسربات الغاز</a></li>
        </ul>
      </nav>
    </div>

    <div class="border-t border-blue-800 pt-6 text-center text-blue-300 text-xs">
      © {new Date().getFullYear()} كشف التسربات والعزل بالسعودية — جميع الحقوق محفوظة
    </div>
  </div>
</footer>
