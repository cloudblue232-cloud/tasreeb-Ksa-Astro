---
import { getSettings } from '../../lib/settings'
const settings = await getSettings()
const PHONE = settings.phone
const WHATSAPP = settings.whatsapp.replace(/\D/g, '')
const waLink = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent('مرحباً، أريد الاستفسار عن خدماتكم')}`
const siteTitle = settings.site_title.split(' ').slice(0, 2).join(' ')
const siteSubTitle = settings.site_title.split(' ').slice(2).join(' ')
---

<a href="#main-content" class="skip-to-content">تخطى إلى المحتوى الرئيسي</a>

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100 shadow-sm relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">

      <!-- Logo -->
      <a href="/" aria-label={`${settings.site_title} — الصفحة الرئيسية`} class="flex items-center gap-2 flex-shrink-0">
        <span class="text-2xl" aria-hidden="true">🔍</span>
        <span class="font-extrabold text-blue-900 text-sm sm:text-base leading-tight">
          {siteTitle}<br /><span class="text-blue-600 font-normal text-xs">{siteSubTitle}</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav aria-label="التنقل الرئيسي" class="hidden md:flex items-center gap-6">
        <a href="/" class="text-gray-700 hover:text-blue-600 font-semibold text-sm transition-colors">الرئيسية</a>
        <a href="/services" class="text-gray-700 hover:text-blue-600 font-semibold text-sm transition-colors">خدماتنا</a>
        <a href="/articles" class="text-gray-700 hover:text-blue-600 font-semibold text-sm transition-colors">المقالات</a>
      </nav>

      <!-- CTA Buttons + Mobile Hamburger -->
      <div class="flex items-center gap-2">
        <a href={`tel:${PHONE}`} id="header-call-btn"
          class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 text-sm font-bold text-blue-700 border-2 border-blue-200 rounded-full hover:bg-blue-50 transition-colors">
          <span aria-hidden="true">📞</span> اتصل الآن
        </a>
        <a href={waLink} id="header-wa-btn" target="_blank" rel="noopener noreferrer"
          aria-label="تواصل معنا عبر واتساب"
          class="btn-whatsapp !py-2 !px-4 !text-sm">
          واتساب
        </a>

        <!-- Hamburger button — visible on mobile only -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="فتح القائمة"
          aria-expanded="false"
          aria-controls="mobile-nav"
          class="md:hidden flex flex-col gap-1.5 w-9 h-9 items-center justify-center rounded-lg hover:bg-gray-100 transition-colors"
        >
          <span id="menu-line-1" class="w-5 h-0.5 bg-gray-700 block transition-all duration-300"></span>
          <span id="menu-line-2" class="w-5 h-0.5 bg-gray-700 block transition-all duration-300"></span>
          <span id="menu-line-3" class="w-5 h-0.5 bg-gray-700 block transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Nav Panel — animated slide-down -->
  <div
    id="mobile-nav"
    class="md:hidden absolute top-full right-0 left-0 mobile-nav-panel"
    aria-hidden="true"
  >
    <div class="mobile-nav-inner">
      <nav aria-label="القائمة الرئيسية للجوال" class="max-w-7xl mx-auto px-4 py-3 flex flex-col gap-1 border-b border-gray-100 bg-white shadow-xl">
        <a href="/" class="nav-link-mobile">الرئيسية</a>
        <a href="/services" class="nav-link-mobile">خدماتنا</a>
        <a href="/articles" class="nav-link-mobile">المقالات</a>
        <a href={`tel:${PHONE}`} class="nav-link-mobile text-blue-700 font-bold">
          <span aria-hidden="true">📞</span> اتصل بنا: {PHONE}
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Mobile nav — collapsed by default */
  .mobile-nav-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition:
      grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.25s ease;
    opacity: 0;
    pointer-events: none;
  }

  /* The inner wrapper must have overflow:hidden for grid-rows trick to work */
  .mobile-nav-inner {
    overflow: hidden;
  }

  /* Open state */
  .mobile-nav-panel.open {
    grid-template-rows: 1fr;
    opacity: 1;
    pointer-events: auto;
  }

  /* Individual link styles */
  .nav-link-mobile {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    color: #374151;
    font-weight: 600;
    border-radius: 0.75rem;
    transition: background-color 0.15s, color 0.15s, transform 0.15s;
    transform: translateY(-4px);
    opacity: 0;
    transition: background-color 0.15s, color 0.15s, transform 0.25s ease, opacity 0.25s ease;
  }

  .mobile-nav-panel.open .nav-link-mobile {
    transform: translateY(0);
    opacity: 1;
  }

  /* Stagger each link's animation */
  .mobile-nav-panel.open .nav-link-mobile:nth-child(1) { transition-delay: 0.05s; }
  .mobile-nav-panel.open .nav-link-mobile:nth-child(2) { transition-delay: 0.1s; }
  .mobile-nav-panel.open .nav-link-mobile:nth-child(3) { transition-delay: 0.15s; }
  .mobile-nav-panel.open .nav-link-mobile:nth-child(4) { transition-delay: 0.2s; }

  .nav-link-mobile:hover {
    background-color: #eff6ff;
    color: #2563eb;
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn')
  const nav = document.getElementById('mobile-nav')
  const l1 = document.getElementById('menu-line-1')
  const l2 = document.getElementById('menu-line-2')
  const l3 = document.getElementById('menu-line-3')

  function openNav() {
    nav?.classList.add('open')
    nav?.setAttribute('aria-hidden', 'false')
    btn?.setAttribute('aria-expanded', 'true')
    btn?.setAttribute('aria-label', 'إغلاق القائمة')
    // Animate hamburger → X
    l1?.style.setProperty('transform', 'translateY(8px) rotate(45deg)')
    l2?.style.setProperty('opacity', '0')
    l3?.style.setProperty('transform', 'translateY(-8px) rotate(-45deg)')
  }

  function closeNav() {
    nav?.classList.remove('open')
    nav?.setAttribute('aria-hidden', 'true')
    btn?.setAttribute('aria-expanded', 'false')
    btn?.setAttribute('aria-label', 'فتح القائمة')
    // Restore hamburger
    l1?.style.removeProperty('transform')
    l2?.style.removeProperty('opacity')
    l3?.style.removeProperty('transform')
  }

  btn?.addEventListener('click', () => {
    nav?.classList.contains('open') ? closeNav() : openNav()
  })

  // Close on link click
  nav?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeNav)
  })
</script>
