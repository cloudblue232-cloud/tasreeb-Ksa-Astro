---
import '../styles/global.css'
import { getSettings } from '../lib/settings'

interface Props {
  title?: string
  description?: string
  image?: string
  canonical?: string
  ogType?: 'website' | 'article'
}

// Load live settings from Supabase (falls back to defaults if unavailable)
const settings = await getSettings()

const SITE_URL = (import.meta.env.NEXT_PUBLIC_SITE_URL || 'https://example.com').replace(/\/$/, '')
const SITE_NAME = settings.site_title

const {
  title,
  description = settings.site_description,
  image,
  canonical = Astro.url.href,
  ogType = 'website',
} = Astro.props

const fullTitle = !title || title === SITE_NAME ? SITE_NAME : `${title} | ${SITE_NAME}`
const ogImage = image ?? `${SITE_URL}/og-default.png`
const googleAdsId = settings.google_ads_id?.trim()
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="EUHcmLY0VX0GVJWITc3aIX_XunthLHIdOSHyNHsZD9c" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Cairo Font — async-loaded to eliminate render-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" />
    </noscript>

    <title>{fullTitle}</title>
    <slot name="head" />

    <!-- Google Ads — injected automatically when google_ads_id is set in Site Settings -->
    {googleAdsId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAdsId}`}></script>
        <script define:vars={{ googleAdsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', googleAdsId);
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
